<local:MyCard x:Class="PCL.CheckInWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:PCL"
              Margin="0,0,0,15" Title="{DynamicResource Widget.CheckIn.Title}">
    <StackPanel Margin="20,38,20,12">
        <!-- 打卡按钮 / 已打卡状态 -->
        <Grid Height="35">
            <local:MyButton x:Name="BtnCheckIn" Text="{DynamicResource Widget.CheckIn.Button}"
                            ColorType="Highlight" Click="BtnCheckIn_Click" />
            <StackPanel x:Name="PanDone" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                <Path Data="M1,6 L5,10 L13,2" StrokeThickness="2" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="12"
                      Margin="0,1,7,0" VerticalAlignment="Center"
                      Stroke="{DynamicResource ColorBrush3}" />
                <TextBlock Text="{DynamicResource Widget.CheckIn.Done}" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush3}" />
            </StackPanel>
        </Grid>
        <!-- 统计 -->
        <TextBlock x:Name="LabStreak" Margin="0,12,0,0" FontSize="13" FontWeight="Bold"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="LabStats" Margin="0,3,0,0" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
        <local:MyTextButton x:Name="BtnMore" Text="{DynamicResource Widget.Common.More}" FontSize="12"
                            HorizontalAlignment="Right" Margin="0,6,-4,0" Click="BtnMore_Click" />
    </StackPanel>
</local:MyCard>
