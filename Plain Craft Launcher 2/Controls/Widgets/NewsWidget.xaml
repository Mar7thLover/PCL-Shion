<local:MyCard x:Class="PCL.NewsWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:PCL"
              Margin="0,0,0,15" Title="{DynamicResource Widget.News.Title}">
    <StackPanel Margin="12,38,12,12">
        <!-- 加载中 / 失败 / 暂无新闻 的提示 -->
        <TextBlock x:Name="LabState" Margin="8,6,8,10" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
        <!-- 最新的几条新闻 -->
        <StackPanel x:Name="PanItems" />
        <local:MyTextButton x:Name="BtnMore" Text="{DynamicResource Widget.Common.More}" FontSize="12"
                            HorizontalAlignment="Right" Margin="0,6,4,0" Click="BtnMore_Click" />
    </StackPanel>
</local:MyCard>
