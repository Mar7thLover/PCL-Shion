<local:MyPageRight x:Class="PCL.PageToolsCheckIn"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <!-- 打卡与统计 -->
            <local:MyCard Margin="0,15" Title="{DynamicResource Widget.CheckIn.Title}">
                <StackPanel Margin="25,40,25,20">
                    <Grid Height="35" HorizontalAlignment="Left">
                        <local:MyButton x:Name="BtnCheckIn" Width="140"
                                        Text="{DynamicResource Widget.CheckIn.Button}"
                                        ColorType="Highlight" Click="BtnCheckIn_Click" />
                        <StackPanel x:Name="PanDone" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                            <Path Data="M1,6 L5,10 L13,2" StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="12"
                                  Margin="0,1,8,0" VerticalAlignment="Center"
                                  Stroke="{DynamicResource ColorBrush3}" />
                            <TextBlock Text="{DynamicResource Widget.CheckIn.Done}" FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush3}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="LabStreak" Margin="0,16,0,0" FontSize="16" FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LabStats" Margin="0,4,0,0" FontSize="13" Opacity="0.6"
                               TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
            <!-- 本月日历 -->
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Widget.CheckIn.Calendar.Title}">
                <Grid Margin="25,40,25,20" MaxWidth="420">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LabMonth" Grid.Row="0" HorizontalAlignment="Center" FontSize="14"
                               Margin="0,0,0,10" />
                    <UniformGrid x:Name="PanWeekdays" Grid.Row="1" Columns="7" Margin="0,0,0,2" />
                    <UniformGrid x:Name="PanDays" Grid.Row="2" Columns="7" />
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
