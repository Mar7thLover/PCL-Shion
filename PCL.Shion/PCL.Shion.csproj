<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <AssemblyName>PCL.Shion</AssemblyName>
        <RootNamespace>PCL.Shion</RootNamespace>
        <Product>PCL Shion</Product>
        <Version>0.1.0</Version>
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <Configurations>Debug;CI;Release;Beta</Configurations>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\PCL.Shion.Core\PCL.Shion.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <AvaloniaResource Include="Assets\**" Exclude="Assets\Strings\**" />
        <EmbeddedResource Include="Assets\Strings\**\*.json" LogicalName="PCL.Shion.Strings.%(Filename).json" WithCulture="false" />
    </ItemGroup>
</Project>
