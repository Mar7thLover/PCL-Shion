<pages:MyPageRight xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:PCL.Shion.Controls"
                    xmlns:loc="using:PCL.Shion.Localization"
                    xmlns:pages="using:PCL.Shion.Pages"
                    x:Class="PCL.Shion.Pages.Setup.PageSetupLauncherMisc">
    <c:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <c:MyCard Margin="0,15" Title="{loc:L Setup.Misc.System.Title}">
                <Grid Margin="25,40,25,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{loc:L Setup.Misc.System.Announcement}" Margin="0,0,25,0"
                               Grid.Row="0" />
                    <c:MyComboBox x:Name="ComboSystemActivity" Tag="SystemSystemActivity" Grid.Column="1"
                                  Grid.Row="0"
                                  SelectionChanged="ComboSystemActivity_OnSelectionChanged">
                        <c:MyComboBoxItem Content="{loc:L Setup.Misc.System.Announcement.All}" ToolTip.Tip="{loc:L Setup.Misc.System.Announcement.All.ToolTip}" />
                        <c:MyComboBoxItem Content="{loc:L Setup.Misc.System.Announcement.ImportantOnly}" />
                        <c:MyComboBoxItem Content="{loc:L Setup.Misc.System.Announcement.Disabled}" />
                    </c:MyComboBox>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{loc:L Setup.Misc.System.MaxFps}"
                               Margin="0,0,25,0" />
                    <c:MySlider x:Name="SliderAniFPS" Grid.Row="2" Tag="UiAniFPS" MaxValue="59" Value="59"
                                Grid.Column="1"
                                ToolTip.Tip="{loc:L Setup.Misc.System.MaxFps.ToolTip}"
                                Change="SliderChange" />
                    <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{loc:L Setup.Misc.System.MaxLogLines}"
                               Margin="0,0,25,0" />
                    <c:MySlider x:Name="SliderMaxLog" Grid.Row="4" Tag="SystemMaxLog" MaxValue="29" Value="13"
                                Grid.Column="1"
                                ToolTip.Tip="{loc:L Setup.Misc.System.MaxLogLines.ToolTip}"
                                Change="SliderChange" />
                    <TextBlock Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{loc:L Setup.Misc.System.RenderBackend}"
                               Margin="0,0,25,0" />
                    <!-- 选项序号与 RenderBackend 枚举值一致；非 Windows 平台锁定为自动 -->
                    <c:MyComboBox x:Name="ComboSystemRenderBackend" Tag="SystemRenderBackend" Grid.Column="1" Grid.Row="6"
                                  ToolTip.Tip="{loc:L Setup.Misc.System.RenderBackend.ToolTip}"
                                  SelectionChanged="ComboSystemRenderBackend_OnSelectionChanged">
                        <c:MyComboBoxItem Content="{loc:L Setup.Misc.System.RenderBackend.Auto}" />
                        <c:MyComboBoxItem Content="{loc:L Setup.Misc.System.RenderBackend.Angle}" />
                        <c:MyComboBoxItem Content="{loc:L Setup.Misc.System.RenderBackend.OpenGl}" />
                        <c:MyComboBoxItem Content="{loc:L Setup.Misc.System.RenderBackend.Vulkan}" />
                        <c:MyComboBoxItem Content="{loc:L Setup.Misc.System.RenderBackend.Software}" />
                    </c:MyComboBox>
                    <Grid Grid.Row="8" Grid.ColumnSpan="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <c:MyCheckBox Grid.Row="0" Grid.Column="0" Text="{loc:L Setup.Misc.System.Telemetry}" x:Name="CheckSystemTelemetry" Tag="SystemTelemetry" Change="CheckBoxChange"
                                      ToolTip.Tip="{loc:L Setup.Misc.System.Telemetry.ToolTip}" />
                        <c:MyCheckBox Grid.Row="0" Grid.Column="1" Margin="25,0,0,0" Text="{loc:L Setup.Misc.System.Notifications}"
                                      x:Name="CheckNotifications" Tag="NotificationsEnabled" Change="CheckBoxChange"
                                      ToolTip.Tip="{loc:L Setup.Misc.System.Notifications.ToolTip}" />
                        <c:MyCheckBox Grid.Row="0" Grid.Column="2" Margin="25,0,0,0" Text="{loc:L Setup.Misc.System.CompletionSound}"
                                      x:Name="CheckCompletionSound" Tag="CompletionSound" Change="CheckBoxChange"
                                      ToolTip.Tip="{loc:L Setup.Misc.System.CompletionSound.ToolTip}" />
                    </Grid>
                    <Grid Grid.Row="10" Grid.ColumnSpan="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                        </Grid.RowDefinitions>
                        <c:MyButton Grid.Column="0" Grid.Row="0" x:Name="BtnSystemSettingExp" MinWidth="140"
                                    Text="{loc:L Setup.Misc.System.ExportSettings}" Padding="13,0" Margin="0,0,20,0"
                                    Click="BtnSystemSettingExp_Click" />
                        <c:MyButton Grid.Column="1" Grid.Row="0" x:Name="BtnSystemSettingImp" MinWidth="140"
                                    Text="{loc:L Setup.Misc.System.ImportSettings}" Padding="13,0" Margin="0,0,20,0"
                                    Click="BtnSystemSettingImp_Click" />
                        <c:MyButton Grid.Column="2" Grid.Row="0" x:Name="BtnSystemStopUsingPclCe" MinWidth="140"
                                    Text="{loc:L Setup.Misc.System.StopUsingPclCe}" Padding="13,0" Margin="0,0,20,0"
                                    ColorType="Red" Click="BtnSystemStopUsingPclCe_Click" />
                    </Grid>
                </Grid>
            </c:MyCard>

            <c:MyCard Margin="0,0,0,15" Title="{loc:L Setup.Misc.Network.Title}">
                <Grid Margin="25,38,25,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <c:MyCheckBox x:Name="CheckNetDohEnable" Tag="SystemNetEnableDoH" Grid.Row="0"
                                  Grid.ColumnSpan="2" Text="{loc:L Setup.Misc.Network.DoH}"
                                  ToolTip.Tip="{loc:L Setup.Misc.Network.DoH.ToolTip}"
                                  Change="CheckBoxChange" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{loc:L Setup.Misc.Network.HttpProxy}"
                               Margin="0,0,25,0" />
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="0.2*" />
                        </Grid.ColumnDefinitions>
                        <c:MyRadioBox Text="{loc:L Setup.Misc.Network.Proxy.None}" x:Name="RadioHttpProxyType0" Height="22"
                                      Tag="SystemHttpProxyType/0" Grid.Column="0"
                                      Check="RadioBoxChange" />
                        <c:MyRadioBox Text="{loc:L Setup.Misc.Network.Proxy.System}" x:Name="RadioHttpProxyType1" Height="22"
                                      Tag="SystemHttpProxyType/1" Grid.Column="1"
                                      Check="RadioBoxChange" />
                        <c:MyRadioBox Text="{loc:L Setup.Misc.Network.Proxy.Custom}" x:Name="RadioHttpProxyType2" Height="22"
                                      Tag="SystemHttpProxyType/2" Grid.Column="2"
                                      Check="RadioBoxChange" />
                    </Grid>
                    <Grid Grid.Row="4" Grid.Column="1" x:Name="HttpProxyCustom" IsVisible="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:MyHint Text="{loc:L Setup.Misc.Network.Proxy.UntrustedWarning}" Grid.Row="0" Grid.ColumnSpan="5" Theme="Yellow" />
                        <c:MyTextBox x:Name="TextSystemHttpProxy" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                     Tag="SystemHttpProxy" HintText="比如 http://127.0.0.1:1080/"
                                     ToolTip.Tip="{loc:L Setup.Misc.Network.Proxy.InvalidWarning}" />
                        <TextBlock Grid.Column="0" Grid.Row="4" Text="{loc:L Setup.Misc.Network.Proxy.Username}" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" Margin="0,0,5,0" />
                        <c:MyTextBox Grid.Column="1" Grid.Row="4" HintText="{loc:L Setup.Misc.Network.Proxy.Optional}" Tag="SystemHttpProxyCustomUsername"
                                     x:Name="TextSystemHttpProxyCustomUsername" Margin="0,0,5,0" />
                        <TextBlock Grid.Column="2" Grid.Row="4" Text="{loc:L Setup.Misc.Network.Proxy.Password}" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" Margin="0,0,5,0" />
                        <c:MyTextBox Grid.Column="3" Grid.Row="4" HintText="{loc:L Setup.Misc.Network.Proxy.Optional}" Tag="SystemHttpProxyCustomPassword"
                                     x:Name="TextSystemHttpProxyCustomPassword" Margin="0,0,5,0" />
                        <c:MyButton Text="{loc:L Setup.Misc.Network.Proxy.Apply}" Grid.Row="4" Grid.Column="4"
                                    x:Name="BtnApplyHttpProxy" Click="ApplyHttpProxyBtn_OnClicked" />
                    </Grid>
                </Grid>
            </c:MyCard>

            <c:MyCard x:Name="CardDebug" Margin="0,0,0,15" Title="{loc:L Setup.Misc.Debug.Title}" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,40,25,15">
                    <Grid x:Name="PanDebugAnim" Height="22" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{loc:L Setup.Misc.Debug.AnimationSpeed}" Margin="0,0,25,0" />
                        <c:MySlider x:Name="SliderDebugAnim" Tag="SystemDebugAnim" MaxValue="30" Grid.Column="1"
                                    Change="SliderChange" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <c:MyCheckBox Grid.Column="0" Text="{loc:L Setup.Misc.Debug.SkipCopy}" Height="22"
                                      x:Name="CheckDebugSkipCopy" Tag="SystemDebugSkipCopy"
                                      ToolTip.Tip="{loc:L Setup.Misc.Debug.SkipCopy.ToolTip}"
                                      Change="CheckBoxChange" />
                        <c:MyCheckBox Grid.Column="1" Text="{loc:L Setup.Misc.Debug.Mode}" Height="22" x:Name="CheckDebugMode"
                                      Tag="SystemDebugMode" ToolTip.Tip="{loc:L Setup.Misc.Debug.Mode.ToolTip}"
                                      Change="CheckDebugMode_OnChange" />
                        <c:MyCheckBox Grid.Column="2" Text="{loc:L Setup.Misc.Debug.Delay}" Height="22" x:Name="CheckDebugDelay"
                                      Tag="SystemDebugDelay"
                                      ToolTip.Tip="{loc:L Setup.Misc.Debug.Delay.ToolTip}"
                                      Change="CheckBoxChange" />
                    </Grid>
                </StackPanel>
            </c:MyCard>
        </StackPanel>
    </c:MyScrollViewer>
</pages:MyPageRight>
