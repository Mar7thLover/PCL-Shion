<pages:MyPageLeft xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:c="using:PCL.Shion.Controls"
                  xmlns:loc="using:PCL.Shion.Localization"
                  xmlns:pages="using:PCL.Shion.Pages"
                  x:Class="PCL.Shion.Pages.Setup.PageSetupLeft">
    <c:MyScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Theme="{StaticResource ScrollViewerFullMargin}">
        <StackPanel Margin="0,12,0,0" x:Name="PanItem">
            <TextBlock Text="{loc:L Setup.Left.Category.Game}" Margin="13,5,5,3" Opacity="0.6" FontSize="12"
                       x:Name="TextGameCategory" />

            <c:MyListItem x:Name="ItemLaunch" IsScaleAnimationEnabled="False" Tag="0" MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top" Title="{loc:L Setup.Left.Item.Launch}" Type="RadioBox"
                          Check="PageCheck" LogoScale="1" SvgIcon="lucide/rocket">
                <c:MyListItem.ButtonList>
                        <c:MyIconButton Tag="0" ToolTip.Tip="{loc:L Common.Action.Initialize}"
                                        ToolTip.Placement="Right"
                                        ToolTip.ShowDelay="200" ToolTip.VerticalOffset="-1"
                                        Click="Reset"
                                        SvgIcon="lucide/rotate-ccw"
                                        LogoScale="0.9" />
                    </c:MyListItem.ButtonList>
            </c:MyListItem>

            <c:MyListItem x:Name="ItemJava" IsScaleAnimationEnabled="False" Tag="9" MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top" Title="{loc:L Setup.Left.Item.Java}" Type="RadioBox"
                          Check="PageCheck" LogoScale="1" SvgIcon="lucide/coffee">
                <c:MyListItem.ButtonList>
                        <c:MyIconButton Tag="9" ToolTip.Tip="{loc:L Common.Action.Refresh}"
                                        ToolTip.Placement="Right"
                                        ToolTip.ShowDelay="200" ToolTip.VerticalOffset="-1"
                                        Click="Refresh" LogoScale="0.85"
                                        SvgIcon="lucide/refresh-cw" />
                    </c:MyListItem.ButtonList>
            </c:MyListItem>

            <c:MyListItem x:Name="ItemGameManage" IsScaleAnimationEnabled="False" Tag="2" MinPaddingRight="35"
                          Check="PageCheck" Height="36" VerticalAlignment="Top"
                          Title="{loc:L Setup.Left.Item.GameManage}" Type="RadioBox"
                          LogoScale="0.95" SvgIcon="lucide/book-marked">
                <c:MyListItem.ButtonList>
                        <c:MyIconButton Tag="2" ToolTip.Tip="{loc:L Common.Action.Initialize}"
                                        ToolTip.Placement="Right"
                                        ToolTip.ShowDelay="200" ToolTip.VerticalOffset="-1"
                                        Click="Reset"
                                        SvgIcon="lucide/rotate-ccw"
                                        LogoScale="0.9" />
                    </c:MyListItem.ButtonList>
            </c:MyListItem>

            <TextBlock Text="{loc:L Setup.Left.Category.Tools}" Margin="13,5,5,3" Opacity="0.6" FontSize="12"
                       x:Name="TextToolsCategory" />

            <c:MyListItem x:Name="ItemGameLink" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="7"
                          Check="PageCheck" MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                          Title="{loc:L Setup.Left.Item.GameLink}" SvgIcon="lucide/bubbles">
                <c:MyListItem.ButtonList>
                        <c:MyIconButton Tag="7" ToolTip.Tip="{loc:L Common.Action.Initialize}"
                                        ToolTip.Placement="Right"
                                        ToolTip.ShowDelay="200" ToolTip.VerticalOffset="-1"
                                        Click="Reset"
                                        SvgIcon="lucide/rotate-ccw"
                                        LogoScale="0.9" />
                    </c:MyListItem.ButtonList>
            </c:MyListItem>

            <TextBlock Text="{loc:L Setup.Left.Category.Launcher}" Margin="13,5,5,3" Opacity="0.6" FontSize="12"
                       x:Name="TextLauncherCategory" />

            <c:MyListItem x:Name="ItemUI" IsScaleAnimationEnabled="False" Tag="1" MinPaddingRight="35" Height="36"
                          Check="PageCheck" VerticalAlignment="Top" Title="{loc:L Setup.Left.Item.Ui}"
                          SvgIcon="lucide/palette" Type="RadioBox">
                <c:MyListItem.ButtonList>
                        <c:MyIconButton Tag="1" ToolTip.Tip="{loc:L Common.Action.Initialize}"
                                        ToolTip.Placement="Right"
                                        ToolTip.ShowDelay="200" ToolTip.VerticalOffset="-1"
                                        Click="Reset"
                                        SvgIcon="lucide/rotate-ccw"
                                        LogoScale="0.9" />
                    </c:MyListItem.ButtonList>
            </c:MyListItem>

            <c:MyListItem x:Name="ItemLauncherLanguage" IsScaleAnimationEnabled="False" Tag="11" MinPaddingRight="35"
                          Check="PageCheck" Height="36" VerticalAlignment="Top"
                          Title="{loc:L Setup.Language.Title}" Type="RadioBox"
                          LogoScale="0.95" SvgIcon="lucide/earth">
                <c:MyListItem.ButtonList>
                        <c:MyIconButton Tag="11" ToolTip.Tip="{loc:L Common.Action.Initialize}"
                                        ToolTip.Placement="Right"
                                        ToolTip.ShowDelay="200" ToolTip.VerticalOffset="-1"
                                        Click="Reset"
                                        SvgIcon="lucide/rotate-ccw"
                                        LogoScale="0.9" />
                    </c:MyListItem.ButtonList>
            </c:MyListItem>

            <c:MyListItem x:Name="ItemLauncherMisc" IsScaleAnimationEnabled="False" Tag="10" MinPaddingRight="35"
                          Check="PageCheck" Height="36" VerticalAlignment="Top"
                          Title="{loc:L Setup.Left.Item.Misc}" Type="RadioBox"
                          LogoScale="0.95" SvgIcon="lucide/monitor-cog">
                <c:MyListItem.ButtonList>
                        <c:MyIconButton Tag="10" ToolTip.Tip="{loc:L Common.Action.Initialize}"
                                        ToolTip.Placement="Right"
                                        ToolTip.ShowDelay="200" ToolTip.VerticalOffset="-1"
                                        Click="Reset"
                                        SvgIcon="lucide/rotate-ccw"
                                        LogoScale="0.9" />
                    </c:MyListItem.ButtonList>
            </c:MyListItem>

            <TextBlock Text="{loc:L Setup.Left.Category.About}" Margin="13,5,5,3" Opacity="0.6" FontSize="12"
                       x:Name="TextAboutCategory" />

            <c:MyListItem x:Name="ItemAbout" IsScaleAnimationEnabled="False" Tag="4" MinPaddingRight="35"
                          Check="PageCheck" Height="36" VerticalAlignment="Top"
                          Title="{loc:L Setup.Left.Item.About}" Type="RadioBox" SvgIcon="lucide/info" />

            <c:MyListItem x:Name="ItemUpdate" IsScaleAnimationEnabled="False" Tag="8" MinPaddingRight="35"
                          Check="PageCheck" Height="36" VerticalAlignment="Top"
                          Title="{loc:L Setup.Left.Item.Update}" Type="RadioBox" SvgIcon="lucide/refresh-cw" />

            <c:MyListItem x:Name="ItemFeedback" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="6"
                          Check="PageCheck" MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                          Title="{loc:L Setup.Left.Item.Feedback}" LogoScale="0.9" SvgIcon="lucide/message-circle">
                <c:MyListItem.ButtonList>
                        <c:MyIconButton Tag="6" ToolTip.Tip="{loc:L Common.Action.Refresh}"
                                        ToolTip.Placement="Right"
                                        ToolTip.ShowDelay="200" ToolTip.VerticalOffset="-1"
                                        Click="Refresh" LogoScale="0.85"
                                        SvgIcon="lucide/refresh-cw" />
                    </c:MyListItem.ButtonList>
            </c:MyListItem>

            <c:MyListItem x:Name="ItemLog" IsScaleAnimationEnabled="False" Tag="5" MinPaddingRight="35" Height="36"
                          Check="PageCheck" VerticalAlignment="Top" Title="{loc:L Setup.Left.Item.Log}"
                          Type="RadioBox" LogoScale="0.9" SvgIcon="lucide/scroll-text" />
        </StackPanel>
    </c:MyScrollViewer>
</pages:MyPageLeft>
