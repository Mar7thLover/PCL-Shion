<pages:MyPageLeft xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:c="using:PCL.Shion.Controls"
                  xmlns:pages="using:PCL.Shion.Pages"
                  x:Class="PCL.Shion.Pages.Log.PageLogLeft">
    <Grid RowDefinitions="Auto,*,5">
        <c:MyScrollViewer Grid.Row="1"
                          MaxWidth="300"
                          MinWidth="250"
                          DeltaMult="0.7"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Theme="{DynamicResource ScrollViewerFullMargin}">
            <StackPanel x:Name="PanList" />
        </c:MyScrollViewer>
    </Grid>
</pages:MyPageLeft>
