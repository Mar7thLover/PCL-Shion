<pages:MyPageRight xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:c="using:PCL.Shion.Controls"
                   xmlns:loc="using:PCL.Shion.Localization"
                   xmlns:pages="using:PCL.Shion.Pages"
                   x:Class="PCL.Shion.Pages.Instance.Saves.PageInstanceSavesDatapack">
    <Grid>
        <Grid x:Name="PanAllBack">
            <c:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanMain" Margin="25,10,25,10">
                    <c:MySearchBox x:Name="SearchBox" Margin="0,15" HintText="{loc:L Instance.Resource.Search.Hint}" />
                    <c:MyCard x:Name="PanManage" Margin="0,0,0,15">
                        <WrapPanel Margin="15,8,0,15">
                            <c:MyButton x:Name="BtnManageOpen" MinWidth="110" Text="{loc:L Common.Action.OpenFolder}" Padding="13,7"
                                        Margin="0,7,15,0" HorizontalAlignment="Left" ColorType="Highlight" />
                            <c:MyButton x:Name="BtnManageInstall" MinWidth="110" Text="{loc:L Instance.Resource.InstallFromFiles}" Padding="13,7"
                                        Margin="0,7,15,0" HorizontalAlignment="Left" />
                            <c:MyButton x:Name="BtnManageDownload" MinWidth="110" Text="{loc:L Instance.Resource.Datapack.DownloadNew}" Padding="13,7"
                                        Margin="0,7,15,0" HorizontalAlignment="Left" />
                            <c:MyButton x:Name="BtnManageSelectAll" MinWidth="110" Text="{loc:L Instance.Resource.SelectAll}" Padding="13,7"
                                        Margin="0,7,15,0" HorizontalAlignment="Left" />
                            <c:MyButton x:Name="BtnManageInfoExport" MinWidth="110" Text="{loc:L Instance.Resource.ExportInfo}" Padding="13,7"
                                        Margin="0,7,15,0" HorizontalAlignment="Left" ToolTip.Tip="{loc:L Instance.Resource.Datapack.ExportInfo.ToolTip}" />
                        </WrapPanel>
                    </c:MyCard>
                    <c:MyCard x:Name="PanListBack" VerticalAlignment="Top" Opacity="0" Margin="0,0,0,14" Title=" "
                              MinHeight="55">
                        <StackPanel x:Name="PanFilter" Margin="15,13,0,0" Orientation="Horizontal"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" Height="28">
                            <c:MyRadioButton Tag="0" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                             Text="{loc:L Instance.Resource.Filter.All}" x:Name="BtnFilterAll" Checked="True" />
                            <c:MyRadioButton Tag="1" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                             Text="{loc:L Instance.Resource.Filter.Enabled}" x:Name="BtnFilterEnabled" />
                            <c:MyRadioButton Tag="2" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                             Text="{loc:L Instance.Resource.Filter.Disabled}" x:Name="BtnFilterDisabled" />
                            <c:MyRadioButton Tag="3" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                             Text="{loc:L Instance.Resource.Filter.Error}" x:Name="BtnFilterError" />
                        </StackPanel>
                        <StackPanel Margin="0,13,15,0" Orientation="Horizontal" VerticalAlignment="Top"
                                    HorizontalAlignment="Right" Height="28">
                            <c:MyIconTextButton x:Name="BtnSort" Text="{loc:L Instance.Resource.Sort.Text}"
                                                SvgIcon="lucide/arrow-up-down" />
                        </StackPanel>
                        <StackPanel Margin="20,48,18,22" x:Name="PanList" VerticalAlignment="Top" />
                    </c:MyCard>
                </StackPanel>
            </c:MyScrollViewer>
            <c:MyCard x:Name="PanEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" IsVisible="False">
                <StackPanel Margin="20,17">
                    <TextBlock x:Name="TxtEmptyTitle" Margin="0,0,0,9" HorizontalAlignment="Center"
                               Text="{loc:L Instance.Resource.Datapack.Empty.Title}"
                               FontSize="19" UseLayoutRounding="True"
                               Foreground="{DynamicResource ColorBrush3}" />
                    <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                    <TextBlock x:Name="TxtEmptyDescription" Margin="10,10,10,0"
                               Text="{loc:L Instance.Resource.Datapack.Empty.Description}" TextWrapping="Wrap" />
                    <WrapPanel Margin="10,20,10,5" HorizontalAlignment="Center" Orientation="Horizontal">
                        <c:MyButton Height="35" x:Name="BtnHintInstall" MinWidth="130" Text="{loc:L Instance.Resource.InstallFromFiles}" Margin="5,0"
                                    Padding="12,0" ColorType="Highlight" />
                        <c:MyButton Height="35" x:Name="BtnHintDownload" MinWidth="130" Text="{loc:L Instance.Resource.Datapack.DownloadNew}" Margin="5,0"
                                    Padding="12,0" />
                        <c:MyButton Height="35" x:Name="BtnHintOpen" MinWidth="130" Text="{loc:L Common.Action.OpenFolder}" Margin="5,0"
                                    Padding="12,0" />
                    </WrapPanel>
                </StackPanel>
            </c:MyCard>
        </Grid>
        <c:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0"
                  x:Name="PanLoad" UseAnimation="False" IsVisible="False">
            <c:MyLoading x:Name="Load" Text="{loc:L Instance.Resource.Datapack.Loading}" Margin="20,20,20,17"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </c:MyCard>
        <c:MyCard x:Name="CardSelect" IsVisible="False" Opacity="0"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="25,25,25,0" UseAnimation="False">
            <c:MyCard.RenderTransform>
                <TranslateTransform Y="-10" />
            </c:MyCard.RenderTransform>
            <TextBlock x:Name="LabSelect" Text="" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="9" Foreground="{DynamicResource ColorBrush2}" />
            <StackPanel Orientation="Horizontal" Margin="5,28,5,5">
                <c:MyIconTextButton x:Name="BtnSelectEnable" Text="{loc:L Instance.Resource.Enable}"
                                    LogoScale="1.05"
                                    SvgIcon="lucide/circle-check" />
                <c:MyIconTextButton x:Name="BtnSelectDisable" Text="{loc:L Instance.Resource.Disable}"
                                    LogoScale="1"
                                    SvgIcon="lucide/circle-minus" />
                <c:MyIconTextButton x:Name="BtnSelectDelete" Text="{loc:L Common.Action.Delete}"
                                    LogoScale="0.96"
                                    SvgIcon="lucide/trash-2" />
                <c:MyIconTextButton x:Name="BtnSelectCancel" Text="{loc:L Instance.Resource.CancelSelection}"
                                    LogoScale="0.8"
                                    SvgIcon="lucide/x" />
            </StackPanel>
        </c:MyCard>
    </Grid>
</pages:MyPageRight>
