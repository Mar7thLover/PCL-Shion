<pages:MyPageRight xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:c="using:PCL.Shion.Controls"
                   xmlns:loc="using:PCL.Shion.Localization"
                   xmlns:pages="using:PCL.Shion.Pages"
                   x:Class="PCL.Shion.Pages.Instance.PageInstanceCompJarInJar">
    <Grid>
        <c:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanMain" Margin="25,10,25,10">
                <c:MyCard x:Name="PanManage" Margin="0,15,0,15">
                    <WrapPanel Margin="15,8,0,15">
                        <c:MyButton x:Name="BtnBack" MinWidth="110" Text="{loc:L Instance.Resource.BackToParent}"
                                    Padding="13,7" Margin="0,7,15,0" HorizontalAlignment="Left"
                                    ColorType="Highlight" />
                        <c:MyButton x:Name="BtnRefresh" MinWidth="110" Text="{loc:L Common.Action.Refresh}"
                                    Padding="13,7" Margin="0,7,15,0" HorizontalAlignment="Left" />
                        <TextBlock VerticalAlignment="Center" Margin="0,7,15,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="{loc:L Instance.Resource.Mod.JarInJar.Message}" />
                    </WrapPanel>
                </c:MyCard>

                <c:MySearchBox x:Name="SearchBox" Margin="0,0,0,15"
                               HintText="{loc:L Instance.Resource.Mod.JarInJar.Search.Hint}" />

                <c:MyCard x:Name="CardWarnings" Margin="0,0,0,15" IsVisible="False">
                    <StackPanel Margin="15,10,15,12">
                        <TextBlock Text="{loc:L Instance.Resource.Mod.JarInJar.Section.Warnings}"
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}" />
                        <StackPanel x:Name="PanWarnList" Margin="0,8,0,0" />
                    </StackPanel>
                </c:MyCard>

                <c:MyCard x:Name="CardConflicts" Margin="0,0,0,15" IsVisible="False">
                    <StackPanel Margin="15,10,15,12">
                        <TextBlock x:Name="TxtConflictsTitle"
                                   Text="{loc:L Instance.Resource.Mod.JarInJar.Section.Conflicts}"
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}" />
                        <StackPanel x:Name="PanConflictList" Margin="0,8,0,0" />
                    </StackPanel>
                </c:MyCard>

                <StackPanel x:Name="SectionRelations" IsVisible="False">
                    <TextBlock Text="{loc:L Instance.Resource.Mod.JarInJar.Section.Relations}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}"
                               Margin="2,0,0,8" />
                    <StackPanel x:Name="PanRelationList" />
                </StackPanel>

                <StackPanel x:Name="SectionBundled" IsVisible="False">
                    <TextBlock Text="{loc:L Instance.Resource.Mod.JarInJar.Section.Bundled}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}"
                               Margin="2,4,0,8" />
                    <StackPanel x:Name="PanBundledList" />
                </StackPanel>
            </StackPanel>
        </c:MyScrollViewer>

        <c:MyCard x:Name="PanEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                  IsVisible="False">
            <StackPanel Margin="20,17">
                <TextBlock Margin="0,0,0,9" HorizontalAlignment="Center"
                           Text="{loc:L Instance.Resource.Mod.JarInJar.Empty.Title}" FontSize="19"
                           UseLayoutRounding="True" Foreground="{DynamicResource ColorBrush3}" />
                <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                <TextBlock Margin="10,10,10,0" Text="{loc:L Instance.Resource.Mod.JarInJar.Empty.Message}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" />
                <c:MyButton x:Name="BtnEmptyBack" Height="35" MinWidth="130"
                            Text="{loc:L Instance.Resource.BackToParent}" Margin="5,20,5,5" Padding="12,0"
                            HorizontalAlignment="Center" ColorType="Highlight" />
            </StackPanel>
        </c:MyCard>

        <c:MyCard x:Name="PanLoad" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0"
                  UseAnimation="False">
            <c:MyLoading x:Name="Load" Text="{loc:L Instance.Resource.Loading}" Margin="20,20,20,17"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </c:MyCard>
    </Grid>
</pages:MyPageRight>
