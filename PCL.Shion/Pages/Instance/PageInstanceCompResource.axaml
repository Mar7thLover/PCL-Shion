<pages:MyPageRight xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:c="using:PCL.Shion.Controls"
                   xmlns:loc="using:PCL.Shion.Localization"
                   xmlns:pages="using:PCL.Shion.Pages"
                   x:Class="PCL.Shion.Pages.Instance.PageInstanceCompResource">
    <Grid x:Name="PanAllBack">
        <c:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Grid.IsSharedSizeScope="True" x:Name="PanMain" Margin="25,10,25,10">
                <c:MySearchBox x:Name="SearchBox" Margin="0,15" HintText="{loc:L Instance.Resource.Search.Hint}" />

                <c:MyCard x:Name="PanManage" Margin="0,0,0,15">
                    <WrapPanel Margin="15,8,0,15">
                        <c:MyButton x:Name="BtnManageBack" MinWidth="110" Text="{loc:L Instance.Resource.BackToParent}"
                                    Padding="13,7" Margin="0,7,15,0" HorizontalAlignment="Left" IsVisible="False" />
                        <c:MyButton x:Name="BtnManageOpen" MinWidth="110" Text="{loc:L Common.Action.OpenFolder}"
                                    Padding="13,7" Margin="0,7,15,0" HorizontalAlignment="Left"
                                    ColorType="Highlight" />
                        <c:MyButton x:Name="BtnManageInstall" MinWidth="110" Text="{loc:L Instance.Resource.InstallFromFiles}"
                                    Padding="13,7" Margin="0,7,15,0" HorizontalAlignment="Left" />
                        <c:MyButton x:Name="BtnManageDownload" MinWidth="110" Text="{loc:L Instance.Resource.DownloadNew}"
                                    Padding="13,7" Margin="0,7,15,0" HorizontalAlignment="Left" />
                        <c:MyButton x:Name="BtnManageInfoExport" MinWidth="110" Text="{loc:L Instance.Resource.ExportInfo}"
                                    Padding="13,7" Margin="0,7,15,0" HorizontalAlignment="Left" />
                        <c:MyButton x:Name="BtnManageSelectAll" MinWidth="110" Text="{loc:L Instance.Resource.SelectAll}"
                                    Padding="13,7" Margin="0,7,15,0" HorizontalAlignment="Left" />
                        <c:MyButton x:Name="BtnManageJarInJar" MinWidth="110" Text="{loc:L Instance.Resource.Mod.JarInJar.Entry}"
                                    Padding="13,7" Margin="0,7,15,0" HorizontalAlignment="Left" />
                    </WrapPanel>
                </c:MyCard>

                <StackPanel x:Name="PanFilter" Orientation="Horizontal" Margin="0,0,0,10">
                    <c:MyRadioButton x:Name="BtnFilterAll" Tag="0" Margin="0,0,8,0" />
                    <c:MyRadioButton x:Name="BtnFilterCanUpdate" Tag="3" Margin="0,0,8,0" IsVisible="False" />
                    <c:MyRadioButton x:Name="BtnFilterEnabled" Tag="1" Margin="0,0,8,0" IsVisible="False" />
                    <c:MyRadioButton x:Name="BtnFilterDisabled" Tag="2" Margin="0,0,8,0" IsVisible="False" />
                    <c:MyRadioButton x:Name="BtnFilterError" Tag="4" Margin="0,0,8,0" IsVisible="False" />
                    <c:MyRadioButton x:Name="BtnFilterDuplicate" Tag="5" Margin="0,0,8,0" IsVisible="False" />
                </StackPanel>

                <c:MyCard x:Name="PanMissingDeps" Margin="0,0,0,15" IsVisible="False"
                          Title="{loc:L Instance.Resource.MissingDependency.Title}">
                    <StackPanel x:Name="PanMissingDepsList" Margin="25,40,25,12" />
                </c:MyCard>

                <c:MyCard x:Name="PanListBack" Margin="0,0,0,15" VerticalAlignment="Top" MinHeight="55"
                          Title=" ">
                    <Grid>
                        <StackPanel Margin="0,13,15,0" Orientation="Horizontal" VerticalAlignment="Top"
                                    HorizontalAlignment="Right" Height="28">
                            <c:MyIconTextButton x:Name="BtnSort" Text="{loc:L Instance.Resource.Sort.Text}"
                                                SvgIcon="lucide/arrow-up-down" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="PanList" Margin="20,48,18,22" VerticalAlignment="Top" />
                </c:MyCard>
            </StackPanel>
        </c:MyScrollViewer>

        <c:MyCard x:Name="PanEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                  IsVisible="False">
            <StackPanel Margin="20,17">
                <TextBlock x:Name="TxtEmptyTitle" Margin="0,0,0,9" HorizontalAlignment="Center" FontSize="19"
                           UseLayoutRounding="True" Foreground="{DynamicResource ColorBrush3}" />
                <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                <TextBlock x:Name="TxtEmptyDescription" Margin="10,10,10,0" TextWrapping="Wrap"
                           HorizontalAlignment="Center" />
                <WrapPanel HorizontalAlignment="Center" Margin="5,20,5,5">
                    <c:MyButton x:Name="BtnHintBack" Height="35" MinWidth="130" Margin="5,0,5,0" Padding="12,0"
                                Text="{loc:L Instance.Resource.BackToParent}" IsVisible="False" />
                    <c:MyButton x:Name="BtnHintOpen" Height="35" MinWidth="130" Margin="5,0,5,0" Padding="12,0"
                                Text="{loc:L Common.Action.OpenFolder}" ColorType="Highlight" />
                    <c:MyButton x:Name="BtnHintInstall" Height="35" MinWidth="130" Margin="5,0,5,0" Padding="12,0"
                                Text="{loc:L Instance.Resource.InstallFromFiles}" />
                    <c:MyButton x:Name="BtnHintDownload" Height="35" MinWidth="130" Margin="5,0,5,0" Padding="12,0"
                                Text="{loc:L Instance.Resource.DownloadNew}" />
                </WrapPanel>
            </StackPanel>
        </c:MyCard>

        <c:MyCard x:Name="PanSchematicEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                  IsVisible="False">
            <StackPanel Margin="20,17">
                <TextBlock Margin="0,0,0,9" HorizontalAlignment="Center" FontSize="19"
                           Text="{loc:L Instance.Resource.Schematic.Unavailable.Title}"
                           Foreground="{DynamicResource ColorBrush3}" />
                <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                <TextBlock Margin="10,10,10,0" TextWrapping="Wrap" HorizontalAlignment="Center"
                           Text="{loc:L Instance.Resource.Schematic.Unavailable.Message}" />
                <WrapPanel HorizontalAlignment="Center" Margin="5,20,5,5">
                    <c:MyButton x:Name="BtnSchematicDownloadMod" Height="35" MinWidth="130" Margin="5,0,5,0" Padding="12,0"
                                Text="{loc:L Instance.Resource.Schematic.DownloadMod}" ColorType="Highlight" />
                    <c:MyButton x:Name="BtnSchematicVersionSelect" Height="35" MinWidth="130" Margin="5,0,5,0"
                                Padding="12,0" Text="{loc:L Instance.Resource.Mod.Disabled.SelectInstance}" />
                </WrapPanel>
            </StackPanel>
        </c:MyCard>

        <c:MyCard x:Name="PanLoad" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0"
                  UseAnimation="False">
            <c:MyLoading x:Name="Load" Margin="20,20,20,17" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="{loc:L Instance.Resource.Loading}" />
        </c:MyCard>

        <c:MyCard x:Name="CardSelect" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15"
                  IsVisible="False" Opacity="0">
            <StackPanel Margin="20,12,20,12" Orientation="Horizontal">
                <TextBlock x:Name="LabSelect" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" />
                <c:MyButton x:Name="BtnSelectEnable" MinWidth="90" Padding="10,6" Margin="0,0,8,0"
                            Text="{loc:L Instance.Resource.Enable}" />
                <c:MyButton x:Name="BtnSelectDisable" MinWidth="90" Padding="10,6" Margin="0,0,8,0"
                            Text="{loc:L Instance.Resource.Disable}" />
                <c:MyButton x:Name="BtnSelectUpdate" MinWidth="90" Padding="10,6" Margin="0,0,8,0"
                            Text="{loc:L Instance.Resource.Update}" />
                <c:MyButton x:Name="BtnSelectFavorites" MinWidth="90" Padding="10,6" Margin="0,0,8,0"
                            Text="{loc:L Instance.Resource.Favorite}" />
                <c:MyButton x:Name="BtnSelectShare" MinWidth="90" Padding="10,6" Margin="0,0,8,0"
                            Text="{loc:L Instance.Resource.ShareSelected}" />
                <c:MyButton x:Name="BtnSelectDelete" MinWidth="90" Padding="10,6" Margin="0,0,8,0"
                            Text="{loc:L Common.Action.Delete}" ColorType="Highlight" />
                <c:MyButton x:Name="BtnSelectCancel" MinWidth="90" Padding="10,6"
                            Text="{loc:L Common.Action.Cancel}" />
            </StackPanel>
        </c:MyCard>
    </Grid>
</pages:MyPageRight>
