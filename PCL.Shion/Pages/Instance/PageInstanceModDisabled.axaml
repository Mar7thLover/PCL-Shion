<pages:MyPageRight xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:c="using:PCL.Shion.Controls"
                       xmlns:loc="using:PCL.Shion.Localization"
                       xmlns:pages="using:PCL.Shion.Pages"
                       x:Class="PCL.Shion.Pages.Instance.PageInstanceModDisabled">
    <c:MyCard x:Name="PanMain" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
        <Grid Margin="20,17">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,9" HorizontalAlignment="Center"
                       Text="{loc:L Instance.Resource.Mod.Disabled.Title}" FontSize="19" UseLayoutRounding="True"
                       Foreground="{DynamicResource ColorBrush3}" />
            <Rectangle Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Stretch" Height="2"
                       Fill="{DynamicResource ColorBrush3}" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="10,15,10,5"
                       Text="{loc:L Instance.Resource.Mod.Disabled.Message}"
                       TextWrapping="Wrap" />
            <c:MyButton x:Name="BtnDownload" Grid.Row="3" Grid.Column="1" Height="35" HorizontalAlignment="Center"
                        MinWidth="140" Text="{loc:L Instance.Resource.Mod.Disabled.GoDownload}"
                        Margin="10,10,10,0" Padding="13,0" ColorType="Highlight" />
            <c:MyButton x:Name="BtnVersion" Grid.Row="3" Grid.Column="2" Height="35" HorizontalAlignment="Center"
                        MinWidth="140" Text="{loc:L Instance.Resource.Mod.Disabled.SelectInstance}"
                        Margin="10,10,10,0" Padding="13,0" />
        </Grid>
    </c:MyCard>
</pages:MyPageRight>
