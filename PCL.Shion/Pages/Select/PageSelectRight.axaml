<pages:MyPageRight xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:c="using:PCL.Shion.Controls"
                   xmlns:loc="using:PCL.Shion.Localization"
                   xmlns:pages="using:PCL.Shion.Pages"
                   x:Class="PCL.Shion.Pages.Select.PageSelectRight">
    <Grid>
        <Grid x:Name="PanAllBack" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Margin="25,15,25,12" ColumnDefinitions="*,Auto">
                <c:MySearchBox x:Name="PanVerSearchBox" VerticalAlignment="Top"
                               ToolTip.Tip="{loc:L Select.Instance.Search.ToolTip}" />
                <!-- 选项序号与 InstanceSortMode 枚举值一致 -->
                <c:MyComboBox x:Name="ComboSort" Grid.Column="1" Width="130" Margin="10,0,0,0"
                              VerticalAlignment="Stretch" ToolTip.Tip="{loc:L Select.Instance.Sort.ToolTip}"
                              SelectionChanged="ComboSort_SelectionChanged">
                    <c:MyComboBoxItem Content="{loc:L Select.Instance.Sort.Name}" />
                    <c:MyComboBoxItem Content="{loc:L Select.Instance.Sort.Version}" />
                    <c:MyComboBoxItem Content="{loc:L Select.Instance.Sort.LastPlayed}" />
                </c:MyComboBox>
            </Grid>
            <c:MyScrollViewer x:Name="PanBack" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanMain" Margin="25,2,25,10" Grid.IsSharedSizeScope="True" />
            </c:MyScrollViewer>
            <c:MyCard x:Name="PanEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="40" UseAnimation="False">
                <StackPanel Margin="20,17">
                    <TextBlock x:Name="LabEmptyTitle" Margin="0,0,0,9" HorizontalAlignment="Center"
                               Text="{loc:L Select.Instance.Empty.Title}"
                               FontSize="19" UseLayoutRounding="True"
                               Foreground="{DynamicResource ColorBrush3}" />
                    <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                    <TextBlock x:Name="LabEmptyContent" Margin="10,15,10,5"
                               Text="{loc:L Select.Instance.Empty.Message}"
                               TextWrapping="Wrap" />
                    <c:MyButton x:Name="BtnEmptyDownload" Height="35" HorizontalAlignment="Center" MinWidth="140"
                                Text="{loc:L Select.Instance.Empty.Download}" Margin="0,10,0,0"
                                Padding="13,0" ColorType="Highlight" />
                </StackPanel>
            </c:MyCard>
            <c:MyCard x:Name="PanEmptySearch" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="40" UseAnimation="False">
                <StackPanel Margin="20,17">
                    <TextBlock x:Name="LabEmptySearchTitle" Margin="0,0,0,9" HorizontalAlignment="Center"
                               Text="{loc:L Select.Instance.EmptySearch.Title}"
                               FontSize="19" UseLayoutRounding="True"
                               Foreground="{DynamicResource ColorBrush3}" />
                    <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                    <TextBlock x:Name="LabEmptySearchContent" Margin="10,15,10,5" TextWrapping="Wrap" />
                </StackPanel>
            </c:MyCard>
        </Grid>
        <c:MyCard x:Name="PanLoad" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
            <c:MyLoading x:Name="Load" Text="{loc:L Select.Instance.Loading}" Margin="20,20,20,17"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsHitTestVisible="False" AutoRun="False" />
        </c:MyCard>
    </Grid>
</pages:MyPageRight>
