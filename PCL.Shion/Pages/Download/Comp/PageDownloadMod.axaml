<pages:MyPageRight xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:c="using:PCL.Shion.Controls"
                   xmlns:loc="using:PCL.Shion.Localization"
                   xmlns:pages="using:PCL.Shion.Pages"
                   xmlns:comp="using:PCL.Shion.Pages.Download.Comp"
                   x:Class="PCL.Shion.Pages.Download.Comp.PageDownloadMod">
    <comp:PageComp x:Name="ModList" PageType="Mod">
        <c:MyComboBoxItem Content="{loc:L Common.Option.All}" Tag="" IsSelected="True" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.WorldGen}" Tag="406/worldgen" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Biomes}" Tag="407/" Margin="15,0,0,0" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Dimensions}" Tag="410/" Margin="15,0,0,0" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.OresResources}" Tag="408/" Margin="15,0,0,0" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Structures}" Tag="409/" Margin="15,0,0,0" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Technology}" Tag="412/technology" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.PipesLogistics}" Tag="415/" Margin="15,0,0,0" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Automation}" Tag="4843/" Margin="15,0,0,0" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Energy}" Tag="417/" Margin="15,0,0,0" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Redstone}" Tag="4558/" Margin="15,0,0,0" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.FoodCooking}" Tag="436/food" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Farming}" Tag="416/" Margin="15,0,0,0" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.GameMechanics}" Tag="/game-mechanics" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Transportation}" Tag="414/transportation" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Storage}" Tag="420/storage" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Magic}" Tag="419/magic" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Adventure}" Tag="422/adventure" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Decoration}" Tag="424/decoration" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Mobs}" Tag="411/mobs" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Utility}" Tag="5191/utility" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Equipment}" Tag="434/equipment" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Creative}" Tag="9026/" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Optimization}" Tag="6814/optimization" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Display}" Tag="423/" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Server}" Tag="435/social" />
        <c:MyComboBoxItem Content="{loc:L Download.Comp.Category.Library}" Tag="421/library" />
    </comp:PageComp>
</pages:MyPageRight>
