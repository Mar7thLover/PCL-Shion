<pages:MyPageRight xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:c="using:PCL.Shion.Controls"
                   xmlns:loc="using:PCL.Shion.Localization"
                   xmlns:pages="using:PCL.Shion.Pages"
                   x:Class="PCL.Shion.Pages.Download.PageDownloadClient">
    <Grid>
        <c:MyScrollViewer x:Name="PanBack"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="5">
                <StackPanel x:Name="PanMain" Margin="20,20,20,5" />
            </StackPanel>
        </c:MyScrollViewer>
        <c:MyCard x:Name="PanLoad"
                  Margin="40,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  UseAnimation="False">
            <c:MyLoading x:Name="Load"
                         Margin="20,20,20,17"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Text="{loc:L Download.Version.LoadingList}" />
        </c:MyCard>
    </Grid>
</pages:MyPageRight>
