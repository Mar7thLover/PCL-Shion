<pages:MyPageRight xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:c="using:PCL.Shion.Controls"
                   xmlns:loc="using:PCL.Shion.Localization"
                   xmlns:pages="using:PCL.Shion.Pages"
                   x:Class="PCL.Shion.Pages.Download.PageDownloadNeoForge">
    <c:MyScrollViewer x:Name="PanBack"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Margin="5">
            <c:MyCard Grid.IsSharedSizeScope="True" x:Name="CardTip"
                      Margin="20,20,20,0"
                      Title="{loc:L Download.Version.NeoForge.Intro.Title}">
                <StackPanel Margin="25,40,15,20">
                    <TextBlock Margin="0,0,0,11"
                               Text="{loc:L Download.Version.NeoForge.Intro.Description}"
                               TextWrapping="Wrap" />
                    <Grid Height="35">
                        <c:MyButton x:Name="BtnWeb"
                                    MinWidth="140"
                                    Margin="0,0,20,0"
                                    Padding="13,0"
                                    HorizontalAlignment="Left"
                                    ColorType="Highlight"
                                    Text="{loc:L Download.Version.OpenWebsite}" />
                    </Grid>
                </StackPanel>
            </c:MyCard>
            <StackPanel Grid.IsSharedSizeScope="True" x:Name="PanMain" Margin="20,15,20,5" />
            <c:MyCard x:Name="PanLoad"
                      HorizontalAlignment="Center"
                      Margin="40,50"
                      UseAnimation="False">
                <c:MyLoading x:Name="Load"
                             Margin="20,20,20,17"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Text="{loc:L Download.Version.NeoForge.LoadingList}" />
            </c:MyCard>
        </StackPanel>
    </c:MyScrollViewer>
</pages:MyPageRight>
