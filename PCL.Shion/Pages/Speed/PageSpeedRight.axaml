<pages:MyPageRight xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:c="using:PCL.Shion.Controls"
                   xmlns:pages="using:PCL.Shion.Pages"
                   x:Class="PCL.Shion.Pages.Speed.PageSpeedRight">
    <c:MyScrollViewer x:Name="PanBack"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10" />
    </c:MyScrollViewer>
</pages:MyPageRight>
