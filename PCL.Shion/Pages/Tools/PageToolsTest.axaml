<pages:MyPageRight xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:c="using:PCL.Shion.Controls"
                       xmlns:loc="using:PCL.Shion.Localization"
                       xmlns:pages="using:PCL.Shion.Pages"
                       xmlns:val="using:PCL.Shion.Pages.Tools"
                       x:Class="PCL.Shion.Pages.Tools.PageToolsTest"
                       PanScroll="{Binding #PanBack}">
    <c:MyScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <c:MyCard Margin="0,15" Title="{loc:L Tools.Test.Title}">
                <WrapPanel ItemHeight="50" Margin="25,40,21,5">
                    <c:MyButton x:Name="BtnClear"
                                MinWidth="120"
                                Margin="0,0,15,15"
                                Click="BtnClear_Click"
                                Text="{loc:L Tools.Test.Clean.Title}"
                                ToolTip.Tip="{loc:L Tools.Test.Clean.ToolTip}" />
                    <c:MyButton MinWidth="100"
                                Margin="0,0,15,15"
                                Click="BtnLuck_Click"
                                Text="{loc:L Tools.Test.Luck.Title}" />
                    <c:MyButton MinWidth="120"
                                Margin="0,0,15,15"
                                Click="BtnCreateShortcut_Click"
                                Text="{loc:L Tools.Test.Shortcut.Title}"
                                ToolTip.Tip="{loc:L Tools.Test.Shortcut.ToolTip}" />
                    <c:MyButton MinWidth="120"
                                Margin="0,0,15,15"
                                Click="BtnLaunchCount_Click"
                                Text="{loc:L Tools.Test.LaunchCount.Title}" />
                </WrapPanel>
            </c:MyCard>

            <c:MyCard Margin="0,0,0,15" Title="{loc:L Tools.Test.CustomDownload.Title}">
                <StackPanel Margin="25,40,25,20" Orientation="Vertical">
                    <TextBlock Text="{loc:L Tools.Test.CustomDownload.Description}" TextWrapping="Wrap" />
                    <Grid Margin="0,10,0,0">
                        <Grid.Styles>
                            <Style Selector="TextBlock.Label">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,25,0" />
                            </Style>
                        </Grid.Styles>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Classes="Label" Grid.Column="0" Grid.Row="0" Text="{loc:L Tools.Test.CustomDownload.Url}" />
                        <c:MyTextBox x:Name="TextDownloadUrl" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2"
                                     TextChanged="TextDownloadUrl_TextChanged"
                                     ValidatedTextChanged="TextDownloadUrl_ValidateChanged">
                            <c:MyTextBox.ValidateRules>
                                <val:HttpAndUncValidator />
                            </c:MyTextBox.ValidateRules>
                        </c:MyTextBox>

                        <TextBlock Classes="Label" Grid.Column="0" Grid.Row="2" Text="{loc:L Tools.Test.CustomDownload.SaveTo}" />
                        <c:MyTextBox x:Name="TextDownloadFolder" Grid.Column="1" Grid.Row="2" Margin="0,10"
                                     ValidatedTextChanged="TextDownloadFolder_OnValidatedTextChanged">
                            <c:MyTextBox.ValidateRules>
                                <val:FolderPathValidator />
                            </c:MyTextBox.ValidateRules>
                        </c:MyTextBox>
                        <c:MyTextButton Grid.Column="2" Grid.Row="2" Margin="10,0,5,0" VerticalAlignment="Center"
                                        Click="MyTextButton_Click"
                                        Text="{loc:L Tools.Test.CustomDownload.Select}" />

                        <TextBlock Classes="Label" Grid.Column="0" Grid.Row="3" Text="{loc:L Tools.Test.CustomDownload.FileName}" />
                        <c:MyTextBox x:Name="TextDownloadName" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2"
                                     ValidatedTextChanged="TextDownloadName_ValidateChanged">
                            <c:MyTextBox.ValidateRules>
                                <val:FileNameValidator />
                            </c:MyTextBox.ValidateRules>
                        </c:MyTextBox>
                    </Grid>
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <c:MyButton x:Name="BtnDownloadStart" Grid.Column="0" Width="140"
                                    Margin="0,0,15,0" HorizontalAlignment="Right"
                                    ColorType="Highlight"
                                    Click="BtnDownloadStart_Click"
                                    Text="{loc:L Tools.Test.CustomDownload.Start}" />
                        <c:MyButton x:Name="BtnDownloadOpen" Grid.Column="1" Width="140"
                                    Margin="0,0,15,0" HorizontalAlignment="Left"
                                    Click="BtnDownloadOpen_Click"
                                    Text="{loc:L Common.Action.OpenFolder}" />
                    </Grid>
                </StackPanel>
            </c:MyCard>

            <c:MyCard x:Name="CardSkin" Margin="0,0,0,15" Title="{loc:L Tools.Test.Skin.Title}">
                <StackPanel Margin="25,40,25,15">
                    <Grid x:Name="PanSkinID" Margin="0,14,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,25,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{loc:L Tools.Test.Skin.PlayerName}" />
                        <c:MyTextBox x:Name="TextSkinID" Grid.Column="1" MaxLength="50" />
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="35" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:MyButton x:Name="BtnSkinSave" Grid.Column="0" MinWidth="140" Padding="13,0"
                                        Margin="0,0,20,0"
                                        Click="BtnSkinSave_Click"
                                        Text="{loc:L Tools.Test.Skin.Save}" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </c:MyCard>

            <c:MyCard Margin="0,0,0,15" Title="{loc:L Tools.Test.ServerQuery.Title}">
                <c:MinecraftServerQuery Margin="15,40,15,15" />
            </c:MyCard>

            <c:MyCard Margin="0,0,0,15" Title="{loc:L Tools.Test.Achievement.Title}" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,30,25,15">
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Grid.Row="0" Margin="0,0,25,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{loc:L Tools.Test.Achievement.ItemId}" />
                        <c:MyTextBox x:Name="AchievementBlockTextBox" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2"
                                     MaxLength="50" Margin="0,10" />

                        <TextBlock Grid.Column="0" Grid.Row="1" Margin="0,0,25,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{loc:L Tools.Test.Achievement.Name}" />
                        <c:MyTextBox x:Name="AchievementTitleTextBox" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
                                     MaxLength="50">
                            <c:MyTextBox.ValidateRules>
                                <val:NullOrEmptyValidator />
                            </c:MyTextBox.ValidateRules>
                        </c:MyTextBox>

                        <TextBlock Grid.Column="0" Grid.Row="2" Margin="0,0,25,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{loc:L Tools.Test.Achievement.Line1}" />
                        <c:MyTextBox x:Name="AchievementString1TextBox" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2"
                                     MaxLength="50" Margin="0,10">
                            <c:MyTextBox.ValidateRules>
                                <val:NullOrEmptyValidator />
                            </c:MyTextBox.ValidateRules>
                        </c:MyTextBox>

                        <TextBlock Grid.Column="0" Grid.Row="3" Margin="0,0,25,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{loc:L Tools.Test.Achievement.Line2}" />
                        <c:MyTextBox x:Name="AchievementString2TextBox" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2"
                                     MaxLength="50" />
                    </Grid>
                    <Grid Margin="0,15,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <c:MyButton x:Name="BtnAchievementPreview" Grid.Column="0" Width="140"
                                    Margin="0,0,15,0" HorizontalAlignment="Right"
                                    ColorType="Highlight"
                                    Click="BtnAchievementPreview_Click"
                                    Text="{loc:L Tools.Test.Achievement.Preview}" />
                        <c:MyButton x:Name="BtnAchievementSave" Grid.Column="1" Width="140"
                                    Margin="0,0,15,0" HorizontalAlignment="Left"
                                    Click="BtnAchievementSave_Click"
                                    Text="{loc:L Tools.Test.Achievement.Save}" />
                    </Grid>
                    <Image x:Name="AchievementImage" Width="320" Height="64" Stretch="Uniform" IsVisible="False" />
                </StackPanel>
            </c:MyCard>

            <c:MyCard Margin="0,0,0,15" Title="{loc:L Tools.Test.Avatar.Title}" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,40,25,20" Orientation="Vertical">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="{loc:L Tools.Test.Avatar.Size}" />
                        <c:MyComboBox x:Name="CmbHeadSize" Grid.Column="1" Height="26" SelectedIndex="0">
                            <c:MyComboBoxItem Content="64x64" />
                            <c:MyComboBoxItem Content="96x96" />
                            <c:MyComboBoxItem Content="128x128" />
                        </c:MyComboBox>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:MyButton x:Name="BtnSelectSkin" Grid.Column="1" Width="140" Height="35" Margin="0,0,10,0"
                                    Click="BtnSelectSkin_Click"
                                    Text="{loc:L Tools.Test.Avatar.SelectSkin}" />
                        <c:MyButton Grid.Column="2" Width="140" Height="35"
                                    Click="BtnSaveHead_Click"
                                    Text="{loc:L Tools.Test.Avatar.Save}" />
                    </Grid>
                    <Border x:Name="SkinPreviewBorder" Margin="0,15,0,0" Padding="10" HorizontalAlignment="Center"
                            IsVisible="False">
                        <Grid x:Name="SkinPreviewContainer" Width="80" Height="80">
                            <Image x:Name="ImgFace" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                            <Image x:Name="ImgHair" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                        </Grid>
                    </Border>
                </StackPanel>
            </c:MyCard>
        </StackPanel>
    </c:MyScrollViewer>
</pages:MyPageRight>
