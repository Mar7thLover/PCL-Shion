<pages:MyPageRight xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:c="using:PCL.Shion.Controls"
                       xmlns:pages="using:PCL.Shion.Pages"
                       xmlns:loc="using:PCL.Shion.Localization"
                       x:Class="PCL.Shion.Pages.Tools.PageToolsGameLink"
                       PanScroll="{Binding #PanBack}">
    <!-- TODO(shion): 联机功能依赖 PCL.Core.Link（EasyTier，仅 Windows/WPF），目前仅为占位页面，布局对应 WPF 的 PageToolsGameLink.xaml。 -->
    <c:MyScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="10">
            <c:MyHint x:Name="HintUnavailable"
                      Margin="10"
                      MinHeight="36"
                      HorizontalAlignment="Stretch"
                      Theme="Yellow" />

            <!-- 对应 WPF 中的 NAT 测试与玩家账号入口，联机不可用时仅作展示 -->
            <StackPanel Margin="10,4" HorizontalAlignment="Right" Orientation="Horizontal" Opacity="0.6">
                <c:MyCard Margin="12,0">
                    <StackPanel Orientation="Horizontal" Height="32"
                                ToolTip.Tip="{loc:L Tools.GameLink.Nat.Title}">
                        <c:SvgIcon Width="14" Stretch="Uniform" Margin="12,0,7,0"
                                   IconBrush="{DynamicResource ColorBrushGray1}" Icon="lucide/ethernet-port" />
                        <TextBlock Text="{loc:L Tools.GameLink.Nat.Test}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ColorBrushGray1}" Margin="0,0,12,0" />
                    </StackPanel>
                </c:MyCard>
                <c:MyCard>
                    <StackPanel Orientation="Horizontal" Height="32"
                                ToolTip.Tip="{loc:L Tools.GameLink.Natayark.Account}">
                        <c:SvgIcon Width="14" Stretch="Uniform" Margin="12,0,7,0"
                                   IconBrush="{DynamicResource ColorBrushGray1}" Icon="lucide/user" />
                        <TextBlock Text="{loc:L Tools.GameLink.Natayark.Login}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ColorBrushGray1}" Margin="0,0,12,0" />
                    </StackPanel>
                </c:MyCard>
            </StackPanel>

            <!-- 加入大厅 -->
            <c:MyCard x:Name="CardJoin" Margin="10" Title="{loc:L Tools.GameLink.Join.Title}">
                <StackPanel Margin="10,30,10,10">
                    <TextBlock x:Name="TextJoinDescription"
                               LineHeight="23"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="10,10,10,-2" />
                    <DockPanel Margin="10" Height="28">
                        <c:MyButton x:Name="BtnJoin"
                                    DockPanel.Dock="Right"
                                    Width="50"
                                    Margin="10,0,0,0"
                                    ColorType="Highlight"
                                    IsEnabled="False" />
                        <c:MyButton x:Name="BtnPaste"
                                    DockPanel.Dock="Right"
                                    Width="50"
                                    Margin="10,0,0,0"
                                    IsEnabled="False" />
                        <c:MyButton x:Name="BtnClearLobbyId"
                                    DockPanel.Dock="Right"
                                    Width="50"
                                    Margin="10,0,0,0"
                                    IsEnabled="False" />
                        <c:MyTextBox x:Name="TextJoinLobbyId"
                                     MaxLines="1"
                                     AcceptsReturn="False"
                                     IsEnabled="False" />
                    </DockPanel>
                </StackPanel>
            </c:MyCard>

            <!-- 创建大厅 -->
            <c:MyCard x:Name="CardCreate" Margin="10" Title="{loc:L Tools.GameLink.Create.Title}">
                <StackPanel Margin="10,30,10,10">
                    <TextBlock x:Name="TextCreateDescription"
                               LineHeight="23"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="10,10,10,0" />
                    <DockPanel Margin="10" Height="28">
                        <c:MyButton x:Name="BtnCreate"
                                    DockPanel.Dock="Right"
                                    Width="50"
                                    Margin="10,0,0,0"
                                    ColorType="Highlight"
                                    IsEnabled="False" />
                        <c:MyButton x:Name="BtnRefresh"
                                    DockPanel.Dock="Right"
                                    Width="50"
                                    Margin="10,0,0,0"
                                    IsEnabled="False" />
                        <c:MyButton x:Name="BtnInputPort"
                                    DockPanel.Dock="Right"
                                    Width="80"
                                    Margin="10,0,0,0"
                                    IsEnabled="False" />
                    </DockPanel>
                </StackPanel>
            </c:MyCard>
        </StackPanel>
    </c:MyScrollViewer>
</pages:MyPageRight>
