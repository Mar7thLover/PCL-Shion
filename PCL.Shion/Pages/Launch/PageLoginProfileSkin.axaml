<Grid x:Class="PCL.Shion.Pages.Launch.PageLoginProfileSkin"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:PCL.Shion.Controls"
      xmlns:launch="using:PCL.Shion.Pages.Launch"
      xmlns:loc="using:PCL.Shion.Localization">
    <Grid Margin="0,0,0,0" Background="{DynamicResource ColorBrushTransparent}" x:Name="PanData">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34" />
            <ColumnDefinition />
            <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" MinHeight="30" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Top">
            <launch:MySkin HorizontalAlignment="Center" VerticalAlignment="Top" x:Name="Skin" HasCape="False"
                           Margin="0,0,0,10" IsHitTestVisible="False" />
            <TextBlock x:Name="TextName" Text="Username" Margin="8,0" FontSize="16" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TextType" Text="AuthType" Margin="8,4,8,5" FontSize="12" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ColorBrushGray4}" />
        </StackPanel>
        <c:MyCard Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" x:Name="PanButtons" Opacity="0"
                  CornerRadius="5" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Margin="10,3,9,3">
                <c:MyIconButton Height="24" Margin="0,0.5,9,0" x:Name="BtnSkin"
                                ToolTip.Tip="{loc:L Launch.Account.ProfileSkin.SkinsAndCapes}"
                                ToolTip.Placement="Center"
                                ToolTip.VerticalOffset="35" ToolTip.HorizontalOffset="1"
                                ToolTip.ShowDelay="50"
                                LogoScale="1.08"
                                SvgIcon="lucide/shirt">
                    <c:MyIconButton.ContextMenu>
                        <ContextMenu HorizontalOffset="10" VerticalOffset="18">
                            <c:MyMenuItem x:Name="MenuChangeSkin"
                                          Header="{loc:L Launch.Account.ProfileSkin.ChangeSkin}" />
                            <c:MyMenuItem x:Name="MenuSaveSkin"
                                          Header="{loc:L Launch.Account.ProfileSkin.SaveSkin}" />
                            <c:MyMenuItem x:Name="MenuRefreshSkin"
                                          Header="{loc:L Launch.Account.ProfileSkin.RefreshSkin}" />
                            <c:MyMenuItem x:Name="MenuChangeCape"
                                          Header="{loc:L Launch.Account.ProfileSkin.ChangeCape}" />
                        </ContextMenu>
                    </c:MyIconButton.ContextMenu>
                </c:MyIconButton>
                <c:MyIconButton Height="24" Margin="0,0,9,0" x:Name="BtnEdit"
                                ToolTip.Tip="{loc:L Launch.Account.ProfileSkin.EditProfile}"
                                ToolTip.Placement="Center" ToolTip.VerticalOffset="35"
                                ToolTip.HorizontalOffset="1" ToolTip.ShowDelay="50"
                                LogoScale="1.1"
                                SvgIcon="lucide/pencil">
                    <c:MyIconButton.ContextMenu>
                        <ContextMenu HorizontalOffset="10" VerticalOffset="18">
                            <c:MyMenuItem x:Name="MenuEditPassword"
                                          Header="{loc:L Launch.Account.ProfileSkin.EditPassword}" />
                            <c:MyMenuItem x:Name="MenuEditName"
                                          Header="{loc:L Launch.Account.ProfileSkin.EditUsername}" />
                        </ContextMenu>
                    </c:MyIconButton.ContextMenu>
                </c:MyIconButton>
                <c:MyIconButton Height="24" x:Name="BtnSelect" Margin="0,0,0,0"
                                ToolTip.Tip="{loc:L Launch.Account.ProfileSkin.SwitchProfile}"
                                ToolTip.Placement="Center" ToolTip.VerticalOffset="35"
                                ToolTip.HorizontalOffset="1" ToolTip.ShowDelay="50"
                                LogoScale="1.15"
                                SvgIcon="lucide/arrow-right-left" />
            </StackPanel>
        </c:MyCard>
    </Grid>
</Grid>
