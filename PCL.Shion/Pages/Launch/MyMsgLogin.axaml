<Grid x:Class="PCL.Shion.Pages.Launch.MyMsgLogin"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:PCL.Shion.Controls"
      xmlns:loc="using:PCL.Shion.Localization"
      RenderTransformOrigin="0,0.5" UseLayoutRounding="True" MinWidth="400"
      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
    <Grid.RenderTransform>
        <TransformGroup>
            <RotateTransform Angle="-4" />
            <TranslateTransform X="0" Y="40" />
        </TransformGroup>
    </Grid.RenderTransform>
    <Border x:Name="PanBorder" CornerRadius="7" Background="{DynamicResource ColorBrushBackground}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ColorObjectMsgBoxShadow}" BlurRadius="20" OffsetX="0"
                              OffsetY="2" Opacity="0.8" />
        </Border.Effect>
        <Grid Name="PanMain" VerticalAlignment="Top" Margin="22,22,22,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="13" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="23" Foreground="{DynamicResource ColorBrush2}"
                       HorizontalAlignment="Left" x:Name="LabTitle" Margin="7,-1,70,9"
                       VerticalAlignment="Top" Text="{loc:L Launch.Account.LoginDialog.Title}" />
            <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="2" Fill="{Binding #LabTitle.Foreground}" />
            <c:MyScrollViewer Grid.Row="3" VerticalAlignment="Top" x:Name="PanCaption" Margin="0,0,0,17"
                              Padding="7,0,15,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              DeltaMult="0.7">
                <TextBlock VerticalAlignment="Top" TextTrimming="None" TextWrapping="Wrap" x:Name="LabCaption"
                           FontSize="15" LineHeight="18"
                           Foreground="{DynamicResource ColorBrush1}" FontWeight="Normal" Padding="1" />
            </c:MyScrollViewer>
            <StackPanel Grid.Row="4" Name="PanBtn" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Margin="150,0,8,0" Orientation="Horizontal">
                <c:MyButton ColorType="Normal" x:Name="Btn1"
                            Text="{loc:L Launch.Account.LoginDialog.ReopenWebpage}"
                            Margin="12,0,0,0" TextPadding="7" Padding="5,0" />
                <c:MyButton ColorType="Normal" x:Name="Btn2"
                            Text="{loc:L Launch.Account.LoginDialog.CopyCode}"
                            Margin="12,0,0,0" TextPadding="7" Padding="5,0" />
                <c:MyButton ColorType="Normal" x:Name="Btn3"
                            Text="{loc:L Common.Action.Cancel}"
                            Margin="12,0,0,0" TextPadding="7" Padding="5,0" />
            </StackPanel>
        </Grid>
    </Border>
</Grid>
