<Grid x:Class="PCL.Shion.Pages.Launch.PageLoginAuth"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:PCL.Shion.Controls"
      xmlns:loc="using:PCL.Shion.Localization"
      Margin="0,0,0,-2">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="20" />
        <RowDefinition Height="30" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="50" />
        <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <c:MyIconButton ToolTip.Tip="{loc:L Launch.Account.Auth.ChangeProfile}" Grid.Row="4" Height="14"
                    Opacity="0" x:Name="BtnEdit"
                    ToolTip.Placement="Center" ToolTip.VerticalOffset="32"
                    ToolTip.HorizontalOffset="1" ToolTip.ShowDelay="50" Grid.Column="0"
                    HorizontalAlignment="Center"
                    SvgIcon="lucide/pencil"
                    Margin="8,0,0,0" VerticalAlignment="Center" />
    <c:MyIconButton ToolTip.Tip="{loc:L Launch.Account.Auth.Logout}" Grid.Row="4" Height="14" Opacity="0"
                    x:Name="BtnExit"
                    ToolTip.Placement="Center" ToolTip.VerticalOffset="32"
                    ToolTip.HorizontalOffset="1" ToolTip.ShowDelay="50" Grid.Column="2"
                    HorizontalAlignment="Center"
                    SvgIcon="lucide/log-out"
                    Margin="0,0,8,0" VerticalAlignment="Center" />
    <Grid x:Name="PanOAuth" Grid.Row="0" Grid.RowSpan="8" Grid.Column="0" Grid.ColumnSpan="2"
          HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,10,0,0" IsVisible="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="25" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Path Data="M660.338 528.065c63.61-46.825 105.131-121.964 105.131-206.83 0-141.7-115.29-256.987-256.997-256.987-141.706 0-256.998 115.288-256.998 256.987 0 85.901 42.52 161.887 107.456 208.562-152.1 59.92-260.185 207.961-260.185 381.077 0 21.276 17.253 38.53 38.53 38.53 21.278 0 38.53-17.254 38.53-38.53 0-183.426 149.232-332.671 332.667-332.671 1.589 0 3.113-.207 4.694-.244.8.056 1.553.244 2.362.244 183.434 0 332.664 149.245 332.664 332.671 0 21.276 17.255 38.53 38.533 38.53 21.277 0 38.53-17.254 38.53-38.53 0-174.885-110.354-324.13-264.917-382.809z m-331.803-206.83c0-99.22 80.72-179.927 179.935-179.927s179.937 80.708 179.937 179.927c0 99.203-80.721 179.91-179.937 179.91s-179.935-80.708-179.935-179.91z"
              Fill="{DynamicResource ColorBrush2}" Opacity="0.7" Width="40" Stretch="Uniform"
              Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="4,0,0,0" />
        <c:MyButton x:Name="BtnOAuth" Text="{loc:L Launch.Account.Auth.OAuthLogin}"
                    ColorType="Highlight" Height="28" Width="120" Grid.Row="2" Grid.ColumnSpan="2"
                    HorizontalAlignment="Center" />
        <Grid Grid.Row="4" Grid.ColumnSpan="2" Opacity="0.3" Margin="2,30,2,0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:MyTextButton x:Name="BtnWebsite" Text="{loc:L Launch.Account.Microsoft.Website}"
                            Grid.Column="0" />
            <c:MyTextButton x:Name="BtnUsePassword" Text="{loc:L Launch.Account.Auth.UsePassword}"
                            Grid.Column="2" />
        </Grid>
    </Grid>
    <c:MyTextBox Grid.Row="4" Grid.Column="1" Height="28" x:Name="TextName" />
    <TextBlock x:Name="TextNameTitle" Text="{loc:L Launch.Account.Auth.Email}" Grid.Row="4"
               VerticalAlignment="Center" />
    <c:MyTextBox Grid.Row="6" Grid.Column="1" Height="28" PasswordChar="•" x:Name="TextPass" />
    <TextBlock x:Name="TextPassTitle" Text="{loc:L Launch.Account.Auth.Password}" Grid.Row="6"
               VerticalAlignment="Center" />
    <c:MyTextButton Margin="0,12,2,0" x:Name="BtnLink" Content="{loc:L Launch.Account.Auth.Register}"
                    Grid.Row="7" HorizontalAlignment="Right"
                    Grid.Column="1" Padding="20,0,0,0" HorizontalContentAlignment="Right" FontSize="13"
                    VerticalContentAlignment="Center" IsVisible="False" />
    <Grid x:Name="PanPasswordLinks" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
          Opacity="0.3" Margin="2,20,2,0" HorizontalAlignment="Center" IsVisible="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <c:MyTextButton x:Name="BtnPasswordWebsite" Text="{loc:L Launch.Account.Microsoft.Website}"
                        Grid.Column="0" />
        <c:MyTextButton x:Name="BtnUseOAuth" Text="{loc:L Launch.Account.Auth.UseOAuth}"
                        Grid.Column="2" />
    </Grid>
    <c:MyButton x:Name="BtnBack" Grid.Row="9" Grid.Column="1" Width="50" Margin="-100,0,0,0" ColorType="Normal"
                Text="{loc:L Launch.Account.Auth.Back}" HorizontalAlignment="Center" />
    <c:MyTextButton x:Name="BtnBackOAuth" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="0" Text="{loc:L Launch.Account.Back}"
                    HorizontalAlignment="Center" Opacity="0.3" IsVisible="False" />
    <c:MyButton x:Name="BtnLogin" Grid.Row="9" Grid.Column="1" Width="50" Margin="20,0,0,0" ColorType="Highlight"
                Text="{loc:L Launch.Account.Auth.Login}" HorizontalAlignment="Center" />
</Grid>
