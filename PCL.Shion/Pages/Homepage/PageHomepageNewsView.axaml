<pages:MyPageRight xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:c="using:PCL.Shion.Controls"
                   xmlns:loc="using:PCL.Shion.Localization"
                   xmlns:pages="using:PCL.Shion.Pages"
                   xmlns:local="using:PCL.Shion.Pages.Homepage"
                   x:Class="PCL.Shion.Pages.Homepage.PageHomepageNewsView"
                   x:DataType="local:NewsViewModel"
                   MinWidth="150">
    <!-- 作为工具页面单独显示时由这里滚动；嵌在主页里时，外层滚动区域会给它无限高度，因此这里不会出现滚动条 -->
    <c:MyScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PanMain">
            <ItemsControl ItemsSource="{Binding NewsItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:WaterfallPanel Margin="0,0,0,10"
                                              ColumnSpacing="14"
                                              MaxItemWidth="240"
                                              RowSpacing="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:NewsItem">
                        <c:MyCard>
                            <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                <c:MyImage HorizontalAlignment="Stretch"
                                           CornerRadius="6"
                                           Source="{Binding Image}"
                                           Stretch="UniformToFill"
                                           ToolTip.Tip="{Binding ImageAltText}" />

                                <!-- 标题 -->
                                <Border Grid.Row="1"
                                        Margin="0,5,0,0"
                                        Padding="5,3"
                                        Background="{DynamicResource ColorBrushBackground}"
                                        ClipToBounds="True"
                                        CornerRadius="6">
                                    <TextBlock FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Text="{Binding Title}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- 作者和时间 -->
                                <Grid Grid.Row="2" Margin="0,5,0,0" ColumnDefinitions="*,Auto">
                                    <TextBlock Foreground="{DynamicResource ColorBrushGray2}"
                                               Text="{Binding Author}" />
                                    <TextBlock Grid.Column="1"
                                               Foreground="{DynamicResource ColorBrushGray2}"
                                               Text="{Binding PublishDateText}" />
                                </Grid>

                                <!-- 简介 -->
                                <TextBlock Grid.Row="3"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource ColorBrushGray4}"
                                           Text="{Binding Description}"
                                           TextWrapping="Wrap" />

                                <!-- 点击在代码中处理，不依赖所在页面的 DataContext -->
                                <c:MyTextButton Grid.Row="4"
                                                Margin="0,5,5,0"
                                                HorizontalAlignment="Right"
                                                Click="BtnOpenRead_Click"
                                                Foreground="{DynamicResource ColorBrushGray2}"
                                                Text="{loc:L Launch.Homepage.News.ViewDetail}" />
                            </Grid>
                        </c:MyCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Foreground="{DynamicResource ColorBrushRedLight}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />

            <c:MyCard Margin="32"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsLoading}">
                <c:MyLoading Margin="20,20,20,17" Text="{loc:L Launch.Homepage.News.Loading}" />
            </c:MyCard>
        </Grid>
    </c:MyScrollViewer>
</pages:MyPageRight>
