<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:PCL.Shion.Controls">
    <ControlTheme x:Key="{x:Type local:MyComboBoxItem}" TargetType="local:MyComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource ColorBrushTransparent}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="ItemBorder" Padding="6,4" Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
