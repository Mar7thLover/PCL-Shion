<Border x:Class="PCL.Shion.Controls.MyIconButton"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PCL.Shion.Controls"
        CornerRadius="1000" Background="{DynamicResource ColorBrushSemiTransparent}" BorderThickness="0.001">
    <Border x:Name="PanBack" CornerRadius="1000" RenderTransformOrigin="0.5,0.5" BorderThickness="0.001"
            IsHitTestVisible="False">
        <Grid x:Name="IconHost" Margin="5" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Path x:Name="Path"
                  Stretch="Uniform"
                  RenderTransformOrigin="0.5,0.5" />
            <local:SvgIcon x:Name="ShapeSvgIcon"
                           Stretch="Uniform"
                           IsVisible="False"
                           IconBrush="{Binding #Path.Fill}" />
        </Grid>
        <Border.RenderTransform>
            <ScaleTransform />
        </Border.RenderTransform>
    </Border>
</Border>
