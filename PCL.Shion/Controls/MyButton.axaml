<Border x:Class="PCL.Shion.Controls.MyButton"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="PanBack"
        Focusable="True" UseLayoutRounding="False"
        Background="{DynamicResource ColorBrushSemiTransparent}">
    <Border.Child>
        <Border CornerRadius="3" x:Name="PanFore" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush1}"
                RenderTransformOrigin="0.5,0.5" Background="{DynamicResource ColorBrushHalfWhite}">
            <Border.RenderTransform>
                <ScaleTransform />
            </Border.RenderTransform>
            <TextBlock TextTrimming="None"
                       HorizontalAlignment="Center" x:Name="LabText" VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5" FontSize="13"
                       Foreground="{Binding $parent[Border].BorderBrush}"
                       IsHitTestVisible="False">
                <TextBlock.RenderTransform>
                    <ScaleTransform />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Border>
    </Border.Child>
</Border>
