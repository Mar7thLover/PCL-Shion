<Border x:Class="PCL.Shion.Controls.MySlider"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DesignHeight="16" d:DesignWidth="162"
        MinHeight="16" UseLayoutRounding="False"
        BorderBrush="{DynamicResource ColorBrushBg0}" x:Name="PanBack"
        Background="{StaticResource ColorBrushSemiTransparent}" Focusable="True">
    <Grid x:Name="PanMain" MinHeight="16" MaxHeight="16" IsHitTestVisible="False">
        <Line Height="4" x:Name="LineBack" ClipToBounds="True" Stroke="{DynamicResource ColorBrushBg0}" Opacity="0.3" StrokeThickness="1"
              StartPoint="0,2" EndPoint="10000,2" HorizontalAlignment="Right" Width="0"
              Margin="0,0,1,0" />
        <Line Height="4" x:Name="LineFore" ClipToBounds="True" Stroke="{Binding BorderBrush, ElementName=PanBack}" StrokeThickness="2"
              StartPoint="0,2" EndPoint="10000,2" Width="0" HorizontalAlignment="Left" Margin="1,0,0,0" />
        <Ellipse HorizontalAlignment="Left" Width="10" Height="10"
                 Stroke="{Binding BorderBrush, ElementName=PanBack}" StrokeThickness="1.2"
                 Fill="{DynamicResource ColorBrushBg0}" x:Name="ShapeDot" VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Popup x:Name="Popup" IsHitTestVisible="False"
               VerticalOffset="38" HorizontalOffset="{Binding Margin.Left, ElementName=ShapeDot}"
               Placement="Center" PlacementRect="8,0,0,0" WindowManagerAddShadowHint="False">
            <Border BorderBrush="{DynamicResource ColorBrush1}" BorderThickness="1.5" CornerRadius="3" MaxWidth="500"
                    Background="{DynamicResource ColorBrushWhite}" Margin="0,0,4,4"
                    BoxShadow="0 2 4 0 #66000000">
                <TextBlock x:Name="TextHint" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush1}" Margin="7,5"
                           FontSize="12" />
            </Border>
        </Popup>
    </Grid>
</Border>
