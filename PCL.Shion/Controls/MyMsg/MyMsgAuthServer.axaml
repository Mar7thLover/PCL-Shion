<Grid x:Class="PCL.Shion.Controls.MyMsgAuthServer"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:my="using:PCL.Shion.Controls"
      RenderTransformOrigin="0,0.5" UseLayoutRounding="True" MinWidth="400"
      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
    <!-- TODO(shion): WPF 版阴影颜色取自 ColorObjectMsgBoxShadow，BoxShadow 不支持资源引用，这里使用固定颜色 -->
    <Border x:Name="PanBorder" CornerRadius="7" Background="{DynamicResource ColorBrushBackground}"
            BoxShadow="0 2 20 0 #CC000000">
        <Grid Margin="22,22,22,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="13" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="23" Foreground="{DynamicResource ColorBrush2}"
                       HorizontalAlignment="Left" x:Name="LabTitle" Margin="7,-1,70,9" />
            <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="2" Fill="{Binding Foreground, ElementName=LabTitle}" />
            <my:MyComboBox Grid.Row="4" x:Name="ComboServer" Height="28" IsEditable="True"
                           IsTextSearchEnabled="False" Margin="7,0,7,12" />
            <StackPanel Grid.Row="5" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Margin="150,14,8,0" Orientation="Horizontal">
                <my:MyButton ColorType="Normal" x:Name="Btn1" Margin="12,0,0,0"
                             TextPadding="7" Padding="5,0" />
                <my:MyButton ColorType="Normal" x:Name="Btn2" Margin="12,0,0,0"
                             TextPadding="7" Padding="5,0" />
            </StackPanel>
        </Grid>
    </Border>
</Grid>
