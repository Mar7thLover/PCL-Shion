<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cvt="using:PCL.Shion.Themes"
             xmlns:loc="using:PCL.Shion.Localization"
             x:Class="PCL.Shion.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#1E6FD9" />
                <ColorPaletteResources x:Key="Dark" Accent="#3B86E8" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://PCL.Shion/Themes/Styles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PCL.Shion/Themes/Colors.axaml" />
                <ResourceInclude Source="avares://PCL.Shion/Themes/Resources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

            <!-- Converter -->
            <cvt:AdditionConverter x:Key="AdditionConverter" />
            <cvt:MultiplicationConverter x:Key="MultiplicationConverter" />
            <cvt:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <cvt:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <cvt:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <cvt:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <loc:LocalizationFormatConverter x:Key="LocalizationFormatConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
