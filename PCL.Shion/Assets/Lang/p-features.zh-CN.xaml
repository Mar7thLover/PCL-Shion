<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="Select.Instance.Sort.ToolTip">实例列表的排序方式</sys:String>
    <sys:String x:Key="Select.Instance.Sort.Name">按名称</sys:String>
    <sys:String x:Key="Select.Instance.Sort.Version">按游戏版本</sys:String>
    <sys:String x:Key="Select.Instance.Sort.LastPlayed">按最近游玩</sys:String>
    <sys:String x:Key="Setup.Misc.System.Notifications">系统通知</sys:String>
    <sys:String x:Key="Setup.Misc.System.Notifications.ToolTip">游戏启动、退出和资源下载完成时发送系统通知</sys:String>
    <sys:String x:Key="Setup.Misc.System.CompletionSound">完成提示音</sys:String>
    <sys:String x:Key="Setup.Misc.System.CompletionSound.ToolTip">发送上述通知时同时播放提示音</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.PostExitCommand">退出后执行命令</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.PostExitCommand.ToolTip">游戏退出后执行的命令，可使用 INST_NAME、INST_DIR、INST_MC_DIR、INST_JAVA 环境变量</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.WrapperCommand">包装命令</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.WrapperCommand.ToolTip">放在 Java 之前启动游戏的命令，例如 prime-run、gamemoderun、mangohud</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.EnvironmentVariables">环境变量</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.EnvironmentVariables.ToolTip">为游戏进程额外设置的环境变量，每行一个，格式为 名称=值，以 # 开头的行会被忽略</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.EnvironmentVariables.Hint">每行一个，例如 __GL_THREADED_OPTIMIZATIONS=1</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.Title">已有同一个 Mod</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.Identical.Message">保存位置里已有内容完全相同的文件：{0}

仍要下载吗？</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.Identical.Download">仍然下载</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.Message">文件夹里还有 {0} 的其他文件：
{1}

同一个 Mod 同时存在多个版本可能导致游戏无法启动。要把旧文件移到回收站吗？</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.Remove">移到回收站</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.Keep">保留</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.Removed">已将 {0} 个旧文件移到回收站</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.RemoveFailed">以下文件未能移到回收站：{0}</sys:String>
    <sys:String x:Key="Instance.Resource.MissingDependency.Title">缺少前置 Mod</sys:String>
    <sys:String x:Key="Instance.Resource.MissingDependency.Item">{0}：{1} 需要它</sys:String>
    <sys:String x:Key="Instance.Resource.MissingDependency.Separator">、</sys:String>
    <sys:String x:Key="Instance.Resource.MissingDependency.Download">下载前置</sys:String>
    <sys:String x:Key="Instance.Resource.MissingDependency.Searching">正在查找 {0}……</sys:String>
    <sys:String x:Key="Instance.Resource.MissingDependency.NotFound">在 Modrinth 上没有找到 {0}，请在下载页手动搜索</sys:String>
</ResourceDictionary>
