<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="Select.Instance.Sort.ToolTip">實例清單的排序方式</sys:String>
    <sys:String x:Key="Select.Instance.Sort.Name">依名稱</sys:String>
    <sys:String x:Key="Select.Instance.Sort.Version">依遊戲版本</sys:String>
    <sys:String x:Key="Select.Instance.Sort.LastPlayed">依最近遊玩</sys:String>
    <sys:String x:Key="Setup.Misc.System.Notifications">系統通知</sys:String>
    <sys:String x:Key="Setup.Misc.System.Notifications.ToolTip">遊戲啟動、結束和資源下載完成時傳送系統通知</sys:String>
    <sys:String x:Key="Setup.Misc.System.CompletionSound">完成提示音</sys:String>
    <sys:String x:Key="Setup.Misc.System.CompletionSound.ToolTip">傳送上述通知時同時播放提示音</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.PostExitCommand">結束後執行命令</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.PostExitCommand.ToolTip">遊戲結束後執行的命令，可使用 INST_NAME、INST_DIR、INST_MC_DIR、INST_JAVA 環境變數</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.WrapperCommand">包裝命令</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.WrapperCommand.ToolTip">放在 Java 之前啟動遊戲的命令，例如 prime-run、gamemoderun、mangohud</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.EnvironmentVariables">環境變數</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.EnvironmentVariables.ToolTip">為遊戲處理程序額外設定的環境變數，每行一個，格式為 名稱=值，以 # 開頭的行會被忽略</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.EnvironmentVariables.Hint">每行一個，例如 __GL_THREADED_OPTIMIZATIONS=1</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.Title">已有同一個 Mod</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.Identical.Message">儲存位置裡已有內容完全相同的檔案：{0}

仍要下載嗎？</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.Identical.Download">仍然下載</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.Message">資料夾裡還有 {0} 的其他檔案：
{1}

同一個 Mod 同時存在多個版本可能導致遊戲無法啟動。要把舊檔案移到資源回收筒嗎？</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.Remove">移到資源回收筒</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.Keep">保留</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.Removed">已將 {0} 個舊檔案移到資源回收筒</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.RemoveFailed">以下檔案未能移到資源回收筒：{0}</sys:String>
    <sys:String x:Key="Instance.Resource.MissingDependency.Title">缺少前置 Mod</sys:String>
    <sys:String x:Key="Instance.Resource.MissingDependency.Item">{0}：{1} 需要它</sys:String>
    <sys:String x:Key="Instance.Resource.MissingDependency.Separator">、</sys:String>
    <sys:String x:Key="Instance.Resource.MissingDependency.Download">下載前置</sys:String>
    <sys:String x:Key="Instance.Resource.MissingDependency.Searching">正在尋找 {0}……</sys:String>
    <sys:String x:Key="Instance.Resource.MissingDependency.NotFound">在 Modrinth 上沒有找到 {0}，請在下載頁手動搜尋</sys:String>
</ResourceDictionary>
