<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="Select.Instance.Sort.ToolTip">How instances are sorted</sys:String>
    <sys:String x:Key="Select.Instance.Sort.Name">By name</sys:String>
    <sys:String x:Key="Select.Instance.Sort.Version">By game version</sys:String>
    <sys:String x:Key="Select.Instance.Sort.LastPlayed">By last played</sys:String>
    <sys:String x:Key="Setup.Misc.System.Notifications">System notifications</sys:String>
    <sys:String x:Key="Setup.Misc.System.Notifications.ToolTip">Send a system notification when a game starts or exits and when a download finishes</sys:String>
    <sys:String x:Key="Setup.Misc.System.CompletionSound">Completion sound</sys:String>
    <sys:String x:Key="Setup.Misc.System.CompletionSound.ToolTip">Play a sound together with the notifications above</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.PostExitCommand">Post-exit command</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.PostExitCommand.ToolTip">Command run after the game exits. The INST_NAME, INST_DIR, INST_MC_DIR and INST_JAVA environment variables are available</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.WrapperCommand">Wrapper command</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.WrapperCommand.ToolTip">Command placed before Java when starting the game, such as prime-run, gamemoderun or mangohud</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.EnvironmentVariables">Environment variables</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.EnvironmentVariables.ToolTip">Extra environment variables for the game process, one NAME=value per line; lines starting with # are ignored</sys:String>
    <sys:String x:Key="Instance.Setup.Advanced.EnvironmentVariables.Hint">One per line, e.g. __GL_THREADED_OPTIMIZATIONS=1</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.Title">Mod already present</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.Identical.Message">An identical file already exists in this folder: {0}

Download anyway?</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.Identical.Download">Download anyway</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.Message">The folder also contains other files of {0}:
{1}

Having several versions of the same mod may stop the game from starting. Move the old files to the recycle bin?</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.Remove">Move to recycle bin</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.Keep">Keep</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.Removed">Moved {0} old file(s) to the recycle bin</sys:String>
    <sys:String x:Key="Download.Comp.Duplicate.OtherVersion.RemoveFailed">Could not move these files to the recycle bin: {0}</sys:String>
</ResourceDictionary>
